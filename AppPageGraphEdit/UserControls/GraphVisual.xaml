<Base:IELObjectBase
    x:Class="AppPageGraphEdit.UserControls.GraphVisual"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Base="clr-namespace:IEL.UserElementsControl.Base;assembly=LibraryIEL" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
    <Base:IELObjectBase.RenderTransform>
        <TransformGroup>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
            <SkewTransform/>
            <RotateTransform/>
            <TranslateTransform/>
        </TransformGroup>
    </Base:IELObjectBase.RenderTransform>
    <Grid>
        <StackPanel x:Name="ContainerInput" HorizontalAlignment="Left" Panel.ZIndex="1" Margin="0,2,0,2" VerticalAlignment="Center"/>
        <Border x:FieldModifier="private" x:Name="MainBorderContainer" BorderBrush="Black" BorderThickness="2,2,2,2" CornerRadius="8,8,8,8" Margin="5,0,5,0" MinHeight="40" MinWidth="40">
            <Viewbox x:FieldModifier="protected" x:Name="ViewBoxContent" Margin="3,2,3,2" VerticalAlignment="Center" HorizontalAlignment="Center">

            </Viewbox>
        </Border>
        <StackPanel x:Name="ContainerOutput" HorizontalAlignment="Right" Panel.ZIndex="1" Margin="0,2,0,2" VerticalAlignment="Center"/>
    </Grid>
</Base:IELObjectBase>
